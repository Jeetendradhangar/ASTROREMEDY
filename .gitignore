# ============================================
# AstroRemedy — Root .gitignore
# ============================================

# -------------------- Environment Files --------------------
.env
.env.local
.env.production
.env.staging
# Keep .env.example files tracked
!.env.example

# -------------------- Python / Django (backend/) --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Django
backend/db.sqlite3
backend/staticfiles/
backend/media/
*.log

# Celery
celerybeat-schedule
celerybeat.pid

# -------------------- Node / Next.js (frontend/) --------------------
node_modules/
.next/
out/
.vercel
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -------------------- IDE & OS --------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# -------------------- Agent / AI Config --------------------
.agents/
AGENTS.md
CLAUDE.md

# -------------------- Misc --------------------
base64.txt
*.pem
coverage/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
