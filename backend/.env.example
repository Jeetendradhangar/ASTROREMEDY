# ============================================
# AstroRemedy Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   Copy-Item .env.example .env

# -------------------- Django Core --------------------
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# -------------------- Database --------------------
# Set to True to use PostgreSQL, False for local SQLite
USE_POSTGRES=False

# PostgreSQL Connection (only needed if USE_POSTGRES=True)
DB_NAME=astrology
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=127.0.0.1
DB_PORT=5432

# -------------------- Redis (Celery Broker) --------------------
REDIS_URL=redis://127.0.0.1:6379/0

# -------------------- Cloudinary (Media Storage) --------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# -------------------- Razorpay (Payments) --------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# -------------------- SMS Gateway --------------------
SMS_GATEWAY_API_KEY=your-sms-gateway-key

# -------------------- MSG91 (OTP Service) --------------------
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# -------------------- WhatsApp Business --------------------
# Format: country code + number, no + or spaces (e.g. 919XXXXXXXXX)
WHATSAPP_BUSINESS_NUMBER=91XXXXXXXXXX

# -------------------- Google OAuth 2.0 --------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------- JWT --------------------
JWT_SECRET_KEY=your-jwt-secret-key-here

# -------------------- URLs --------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
